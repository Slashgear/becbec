---
import site from '../data/site.yaml';

const banner = (site as any).banner;
if (!banner?.active || !banner?.message) return;

const type = banner.type === 'alert' ? 'alert' : 'info';

// Contenu servi uniquement au client (voir <script> plus bas) : les crawlers
// qui ne relaient pas de JS ne voient donc jamais ce texte dans le HTML.
const payload = {
  message: banner.message,
  description: banner.description ?? null,
  link: banner.link ?? null,
};
const payloadJson = JSON.stringify(payload).replace(/</g, '\\u003c');

// Hash stable du contenu : sert d'id et de clé de dédoublonnage côté client.
// Il change dès que le contenu de la bannière change dans site.yaml.
function hashContent(str: string) {
  let h = 0;
  for (let i = 0; i < str.length; i++) {
    h = (Math.imul(31, h) + str.charCodeAt(i)) | 0;
  }
  return (h >>> 0).toString(36);
}
const contentHash = hashContent(type + JSON.stringify(payload));
const id = `banner-${contentHash}`;
---

<dialog
  id={id}
  class={`modal modal--${type}`}
  data-banner-hash={contentHash}
  aria-label={banner.type === 'alert' ? 'Alerte' : 'Information'}
>
  <div class="modal-card">
    <button class="modal-close" aria-label="Fermer" autofocus>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>

    {type === 'alert' && (
      <div class="modal-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
      </div>
    )}

    {banner.link
      ? <a href={banner.link} class="modal-message modal-link" data-field="message"></a>
      : <p class="modal-message" data-field="message"></p>
    }

    <p class="modal-description" data-field="description" hidden></p>

    <button class="modal-btn-close">
      Fermer
    </button>
  </div>

  <script type="application/json" set:html={payloadJson} />
</dialog>

<script>
  const STORAGE_KEY = 'becbec-banner-seen';
  const SNOOZE_MS = 30 * 60 * 1000; // 30 min

  // Bots de moteurs de recherche / crawlers SEO / previews réseaux sociaux :
  // on ne leur affiche jamais la bannière ni ne la laisse dans le DOM.
  const BOT_UA = /bot|crawl|spider|slurp|mediapartners|facebookexternalhit|whatsapp|telegrambot|discordbot|slackbot|embedly|quora link preview|pinterest|vkshare|w3c_validator|lighthouse|headlesschrome|semrush|ahrefs|mj12bot|dotbot|petalbot/i;

  const dialog = document.querySelector('dialog.modal');

  if (dialog instanceof HTMLDialogElement) {
    const isBot = BOT_UA.test(navigator.userAgent);

    if (isBot) {
      dialog.remove();
    } else {
      const hash = dialog.dataset.bannerHash ?? '';
      let alreadySeen = false;

      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const seen = raw ? JSON.parse(raw) : null;
        alreadySeen = !!seen && seen.hash === hash && Date.now() - seen.ts < SNOOZE_MS;
      } catch {
        // localStorage indisponible (navigation privée...) : on affiche par défaut
      }

      if (alreadySeen) {
        dialog.remove();
      } else {
        const dataEl = dialog.querySelector('script[type="application/json"]');
        const data = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};

        const messageEl = dialog.querySelector('[data-field="message"]');
        if (messageEl) {
          messageEl.textContent = data.message ?? '';
          if (data.link && messageEl instanceof HTMLAnchorElement) {
            messageEl.href = data.link;
          }
        }

        const descriptionEl = dialog.querySelector('[data-field="description"]');
        if (descriptionEl instanceof HTMLElement && data.description) {
          descriptionEl.textContent = data.description;
          descriptionEl.hidden = false;
        }

        dialog.showModal();

        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify({ hash, ts: Date.now() }));
        } catch {
          // tant pis, la bannière réapparaîtra au prochain chargement
        }
      }
    }
  }

  const dismiss = () => dialog?.close();

  dialog?.querySelectorAll('.modal-close, .modal-btn-close').forEach(btn => {
    btn.addEventListener('click', dismiss);
  });

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dismiss();
  });
</script>

<style>
  .modal {
    border: none;
    border-radius: 6px;
    padding: 0;
    max-width: min(480px, calc(100vw - 2rem));
    width: 100%;
    margin: auto;   /* le reset CSS global écrase le centrage natif du dialog */
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.18), 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .modal::backdrop {
    background: rgba(26, 16, 8, 0.55);
    backdrop-filter: blur(2px);
  }

  /* Animation d'entrée */
  @keyframes modal-in {
    from { opacity: 0; transform: translateY(12px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0)   scale(1); }
  }

  .modal[open] {
    animation: modal-in 0.2s ease-out;
  }

  /* Thèmes */
  .modal--info {
    background: var(--bg);
    color: var(--text);
    border-top: 4px solid var(--red);
  }

  .modal--alert {
    background: var(--red);
    color: #fff;
  }

  /* Card intérieure */
  .modal-card {
    position: relative;
    padding: calc(var(--space-lg) + var(--space-sm)) calc(var(--space-lg) + var(--space-sm)) var(--space-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  /* Icône */
  .modal-icon {
    opacity: 0.9;
  }

  /* Bouton × en haut à droite */
  .modal-close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: var(--radius);
    color: inherit;
    opacity: 0.55;
    transition: opacity 0.15s;
  }

  .modal-close:hover { opacity: 1; }

  .modal-close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    opacity: 1;
  }

  /* Message */
  .modal-message {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: 0.01em;
    text-wrap: pretty;
  }

  .modal-link {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .modal-link:hover { opacity: 0.8; }

  /* Description longue */
  .modal-description {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.6;
    opacity: 0.85;
    max-width: 36ch;
  }

  .modal--info .modal-description {
    border-top: 1px solid var(--red-border);
    padding-top: var(--space-sm);
  }

  .modal--alert .modal-description {
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    padding-top: var(--space-sm);
  }

  /* Bouton Fermer */
  .modal-btn-close {
    margin-top: var(--space-xs);
    padding: 0.5em 1.4em;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: opacity 0.15s;
  }

  .modal--info .modal-btn-close {
    background: var(--red);
    color: #fff;
  }

  .modal--alert .modal-btn-close {
    background: #fff;
    color: var(--red);
  }

  .modal-btn-close:hover { opacity: 0.85; }

  .modal-btn-close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
